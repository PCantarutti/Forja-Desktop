{
  "name": "forja-desktop",
  "productName": "Forja",
  "version": "0.1.0",
  "description": "Forja: agente de IA local com pasta de trabalho, navegador integrado e terminal, num app de desktop.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare-resources": "node scripts/prepare.mjs",
    "dist": "npm run prepare-resources && electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.forja.desktop",
    "productName": "Forja",
    "files": ["electron/**", "package.json"],
    "extraResources": [{ "from": "resources", "to": ".", "filter": ["**/*"] }],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Forja-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
