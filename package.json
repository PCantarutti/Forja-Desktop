{
  "name": "forja-desktop",
  "productName": "Forja",
  "version": "0.4.2",
  "description": "Forja: agente de IA local com pasta de trabalho, navegador integrado e terminal, num app de desktop.",
  "author": "DRUVE",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "prepare-resources": "node scripts/prepare.mjs",
    "dist": "npm run prepare-resources && electron-builder --win nsis",
    "release": "node scripts/release.mjs",
    "publish-only": "npm run prepare-resources && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "dev.forja.desktop",
    "directories": {
      "output": "dist/${version}"
    },
    "productName": "Forja",
    "copyright": "Copyright © 2026 DRUVE",
    "files": [
      "electron/**",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Forja-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forja",
      "uninstallDisplayName": "Forja ${version}",
      "runAfterFinish": true,
      "allowElevation": false,
      "menuCategory": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PCantarutti",
        "repo": "Forja-Desktop"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
